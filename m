-				    (sk->sk_shutdown & SEND_SHUTDOWN) ||
-				    (csk_mem_free(cdev, sk) && !vm_wait),
-				    &wait);
-		sk->sk_write_pending--;
-		if (ret < 0)
-			goto do_error;
-
-		if (vm_wait) {
-			vm_wait -= current_timeo;
-			current_timeo = *timeo_p;
-			if (current_timeo != MAX_SCHEDULE_TIMEOUT) {
-				current_timeo -= vm_wait;
-				if (current_timeo < 0)
-					current_timeo = 0;
-			}
-			vm_wait = 0;
-		}
-		*timeo_p = current_timeo;
