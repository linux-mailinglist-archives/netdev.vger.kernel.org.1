-		cfpkt_destroy(pkt);
-		return 0;
-	case DGM_FLOW_ON:	/* FLOW ON */
-		layr->ctrlcmd(layr, CAIF_CTRLCMD_FLOW_ON_IND, 0);
-		cfpkt_destroy(pkt);
-		return 0;
