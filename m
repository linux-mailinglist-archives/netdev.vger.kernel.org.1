+	strom_ctrl_addr = STORM_CTRL_CONFIG_TBL + idx * 4;
+	CMM_ERR_CHK(HAL_MEM_DIRECT_READ(unit, strom_ctrl_addr, &entry), ret);
+	HAL_FIELD_GET(STORM_CTRL_CONFIG_TBL_STORM_EN_LOWBIT,
