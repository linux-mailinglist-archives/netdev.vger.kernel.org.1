+static int yt922x_port_down(struct yt92xx_priv *priv, int port)
+{
+	int res;
+
+	res = yt_port_mac_enable_set(priv->chip_info->unit, port,
+				     YT_DISABLE);
+	if (res)
+		return res;
+
+	return 0;
+}
