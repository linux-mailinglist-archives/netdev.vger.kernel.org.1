+			      QOS_MERGE_PRECEDENCE_CTRLN_PORT2INT_PRI_WIDTH,
+			      &entry, pri_sel_ptr->port_pri);
+	}
+	CMM_ERR_CHK(HAL_MEM_DIRECT_WRITE
+		(unit, QOS_MERGE_PRECEDENCE_CTRLN(macid), entry), ret);
