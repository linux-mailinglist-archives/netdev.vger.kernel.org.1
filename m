+	struct yt92xx_priv *priv = to_yt92xx_priv(ds);
+	int res;
+
+	if (prio >= YT92XX_PRIO_NUM)
+		return -EINVAL;
+
+	mutex_lock(&priv->reg_lock);
+	res = result_convert(yt_qos_intpri_dscp_map_set
+			(priv->chip_info->unit, dscp, prio));
+	mutex_unlock(&priv->reg_lock);
+
+	return res;
+}
