+		mc_idx = 1;
+	else if (storm_type == YT_STORM_TYPE_IPV6_MCAST ||
+		 storm_type == YT_STORM_TYPE_IPV6_UNKNOWN_MCAST)
+		mc_idx = 2;
+	else
+		mc_idx = 0xff;
