+	switch (result) {
+	case CMM_ERR_OK:
+		res = 0;
+		break;
+	case CMM_ERR_FAIL:
+	case CMM_ERR_NOT_SUPPORT:
+		res = -EOPNOTSUPP;
+		break;
+	case CMM_ERR_NULL_POINT:
+		res = -ENOMEM;
+		break;
+	case CMM_ERR_NOT_INIT:
+		res = -ENOMEM;
+		break;
+	case CMM_ERR_INPUT:
+		res = -EINVAL;
+		break;
+	case CMM_ERR_SAMEENTRY_EXIST:
+	case CMM_ERR_ENTRY_OVERLAPPING:
+		res = -EEXIST;
+		break;
+	case CMM_ERR_FDB_OP_BUSY:
+	case CMM_ERR_ACL_OP_BUSY:
+	case CMM_ERR_BUSYING_TIME:
+		res = -EBUSY;
+		break;
+	default:
+		res = -EINVAL;
+		break;
+	}
