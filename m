-	if (unlikely(is_erronous(pkt)))
-		return -EPROTO;
-	if (unlikely(skb_linearize(&pkt->skb) != 0)) {
-		PKT_ERROR(pkt, "linearize failed\n");
-		return -EPROTO;
-	}
