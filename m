-	struct yt921x_priv *priv = to_yt921x_priv(ds);
-	struct dsa_port *dp;
-	u32 ctrl;
-	int res;
-
-	if (!lag.id)
-		return -EINVAL;
-
-	ctrl = 0;
-	dsa_lag_foreach_port(dp, ds->dst, &lag)
-		ctrl |= BIT(dp->index);
-
-	mutex_lock(&priv->reg_lock);
-	res = yt921x_lag_set(priv, lag.id - 1, ctrl);
-	mutex_unlock(&priv->reg_lock);
-
-	return res;
