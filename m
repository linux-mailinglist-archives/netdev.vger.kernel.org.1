+		attr.phy_type = PHY_INTERNAL;
+		attr.reg_addr = 0x10;
+		attr.reg_space = YT_PHY_REG_SPACE_TX;
+		attr.reg_type = YT_PHY_REG_TYPE_PHY_MII;
