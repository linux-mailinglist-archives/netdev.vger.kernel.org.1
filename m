+			      L2_RRPP_PORT_CTRLN_SA_LEARN_DISABLE_WIDTH,
+			      &entry, &enable);
+	} else if (pkt_type == YT_CTRL_PKT_IGMP_TYPE) {
+		CMM_ERR_CHK(HAL_MEM_DIRECT_READ
+			(unit, L2_IGMP_PER_PORT_CTRLN(macid), &entry), ret);
